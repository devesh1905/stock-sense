datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MANAGER
  STAFF
}

enum LocationType {
  INTERNAL
  VENDOR
  CUSTOMER
  ADJUSTMENT
}

enum OperationType {
  RECEIPT
  DELIVERY
  INTERNAL
  ADJUSTMENT
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

model User {
  id                String             @id @default(uuid())
  loginId           String             @unique
  email             String             @unique
  name              String
  passwordHash      String
  role              Role               @default(STAFF)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  passwordResetOtps PasswordResetOtp[]
  operations        Operation[]        @relation("ResponsibleUser")
  stockMoves        StockMove[]
}

model PasswordResetOtp {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Warehouse {
  id        String     @id @default(uuid())
  name      String
  shortCode String     @unique
  address   String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
}

model Location {
  id               String          @id @default(uuid())
  name             String
  shortCode        String
  fullPath         String
  type             LocationType    @default(INTERNAL)
  warehouseId      String?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quants           StockQuant[]
  movesFrom        StockMove[]     @relation("MoveSourceLocation")
  movesTo          StockMove[]     @relation("MoveDestLocation")
  operationsSource Operation[]     @relation("OperationSourceLocation")
  operationsDest   Operation[]     @relation("OperationDestLocation")
  reorderRules     ReorderRule[]

  @@index([warehouseId])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String          @id @default(uuid())
  name           String
  sku            String          @unique
  categoryId     String?
  uom            String          @default("Units")
  unitCost       Float           @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quants         StockQuant[]
  reorderRules   ReorderRule[]
  operationLines OperationLine[]
  moves          StockMove[]

  @@index([categoryId])
}

model ReorderRule {
  id         String    @id @default(uuid())
  productId  String
  locationId String?
  minQty     Float     @default(0)
  maxQty     Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([locationId])
}

model StockQuant {
  id         String   @id @default(uuid())
  productId  String
  locationId String
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model Operation {
  id               String          @id @default(uuid())
  reference        String          @unique
  type             OperationType
  status           OperationStatus @default(DRAFT)
  contact          String?
  deliveryAddress  String?
  sourceLocationId String?
  destLocationId   String?
  scheduledDate    DateTime?
  responsibleId    String?
  pickedAt         DateTime?
  packedAt         DateTime?
  validatedAt      DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sourceLocation   Location?       @relation("OperationSourceLocation", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destLocation     Location?       @relation("OperationDestLocation", fields: [destLocationId], references: [id], onDelete: SetNull)
  responsible      User?           @relation("ResponsibleUser", fields: [responsibleId], references: [id], onDelete: SetNull)
  lines            OperationLine[]
  moves            StockMove[]

  @@index([type])
  @@index([status])
  @@index([scheduledDate])
}

model OperationLine {
  id          String    @id @default(uuid())
  operationId String
  productId   String
  demandQty   Float     @default(0)
  doneQty     Float     @default(0)
  countedQty  Float?
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@index([productId])
}

model StockMove {
  id             String    @id @default(uuid())
  productId      String
  fromLocationId String
  toLocationId   String
  quantity       Float
  operationId    String?
  userId         String?
  createdAt      DateTime  @default(now())
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation   Location  @relation("MoveSourceLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     Location  @relation("MoveDestLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  operation      Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([operationId])
  @@index([createdAt])
}
